{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin",
      "framework": "nextjs"
    },
    "basewebsite": {
      "root": "Base Website",
      "framework": "nextjs"
    },
    "doctor": {
      "root": "doctor",
      "framework": "vite"
    },
    "patient": {
      "root": "patient",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/patient",
      "destination": {
        "service": "patient"
      }
    },
    {
      "source": "/patient/(.*)",
      "destination": {
        "service": "patient"
      }
    },
    {
      "source": "/doctor",
      "destination": {
        "service": "doctor"
      }
    },
    {
      "source": "/doctor/(.*)",
      "destination": {
        "service": "doctor"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "basewebsite"
      }
    }
  ]
}
